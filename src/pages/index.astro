---
import Layout from "@/layouts/Layout.astro";
import AboutMe from "@/components/AboutMe.astro";
import Experience from "@/components/Experience.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import Projects from "@/components/Projects.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import Services from "@/components/Services.astro";
import Technologies from "@/components/Technologies.astro";
import Process from "@/components/Process.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { siteConfig } from "@/config/site.mjs";
const email = siteConfig.email;
const whatsappNumber = siteConfig.whatsappNumber;
const whatsappHref = whatsappNumber ? `https://wa.me/${whatsappNumber.replace(/\D/g, "")}?text=${encodeURIComponent("Hola, quiero conversar sobre un proyecto")}` : undefined;
---
<Layout title="Dev-Tech | Desarrollo de software y soluciones digitales" description="Desarrollamos sitios web, aplicaciones móviles, sistemas empresariales, e-commerce y automatizaciones para empresas. Conversemos sobre tu próximo proyecto." >
  <main class="overflow-x-clip px-4 pt-24 sm:px-6 sm:pt-28">
    <SectionContainer id="inicio" class="py-8 sm:py-12 lg:py-14"><Hero /></SectionContainer>
    <div class="space-y-24 py-16 sm:space-y-32 sm:py-20">
      <SectionContainer id="servicios"><div class="mb-8 max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.2em] text-cyan-700 dark:text-cyan-300">Qué hacemos</p><h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Soluciones digitales para avanzar.</h2><p class="mt-3 text-slate-600 dark:text-slate-300">Elegimos la tecnología y el alcance según lo que tu negocio necesita resolver.</p></div><Services /></SectionContainer>
      <SectionContainer id="tecnologias"><div class="mb-8 max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.2em] text-cyan-700 dark:text-cyan-300">Herramientas</p><h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Tecnologías que usamos</h2><p class="mt-3 text-slate-600 dark:text-slate-300">Un stack respaldado por proyectos concretos, elegido según las necesidades de cada producto.</p></div><Technologies /></SectionContainer>
      <SectionContainer id="proyectos"><div class="mb-8 max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.2em] text-cyan-700 dark:text-cyan-300">Trabajo seleccionado</p><h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Proyectos destacados</h2><p class="mt-3 text-slate-600 dark:text-slate-300">Una selección de productos y plataformas en los que participamos. Explorá el catálogo para ver los demás.</p></div><Projects /></SectionContainer>
      <SectionContainer id="proceso"><div class="mb-8 max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.2em] text-cyan-700 dark:text-cyan-300">Cómo trabajamos</p><h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Un proceso claro, de principio a evolución.</h2><p class="mt-3 text-slate-600 dark:text-slate-300">Acordamos cada etapa y mantenemos comunicación durante todo el proyecto.</p></div><Process /></SectionContainer>
      <SectionContainer id="experiencia"><div class="mb-8 max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.2em] text-cyan-700 dark:text-cyan-300">Trayectoria</p><h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">Experiencia profesional</h2><p class="mt-3 text-slate-600 dark:text-slate-300">Roles de desarrollo en Dev-Tech y otras iniciativas profesionales.</p></div><Experience /></SectionContainer>
      <SectionContainer id="quienes-somos"><AboutMe /></SectionContainer>
      <SectionContainer id="contacto"><div class="relative overflow-hidden rounded-3xl bg-slate-950 px-6 py-10 text-white sm:px-10 sm:py-14 dark:bg-slate-900"><div class="absolute -right-20 -top-28 size-72 rounded-full bg-cyan-500/20 blur-3xl" aria-hidden="true"></div><div class="relative max-w-2xl"><p class="text-sm font-semibold uppercase tracking-[.2em] text-cyan-300">Contacto</p><h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">¿Tenés una idea para llevar a la realidad?</h2><p class="mt-4 leading-7 text-slate-300">Contanos qué necesitás. Podemos conversar sobre el alcance, las prioridades y el siguiente paso.</p><div class="mt-7 flex flex-wrap gap-3"><a class="inline-flex min-h-12 items-center rounded-full bg-white px-6 text-sm font-semibold text-slate-950 transition hover:bg-cyan-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" href={`mailto:${email}`}>Escribinos por email ↗</a>{whatsappHref && <a class="inline-flex min-h-12 items-center rounded-full border border-white/30 px-6 text-sm font-semibold text-white transition hover:bg-white/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" href={whatsappHref} target="_blank" rel="noopener noreferrer">Hablemos por WhatsApp ↗</a>}</div><p class="mt-5 text-sm text-slate-400"><a class="hover:text-white" href={`mailto:${email}`}>{email}</a></p></div></div></SectionContainer>
    </div>
  </main>
  <Footer />
  <WhatsAppButton />
</Layout>
