---
import { siteConfig } from "@/config/site.mjs";
const number = siteConfig.whatsappNumber;
const href = number ? `https://wa.me/${number}?text=${encodeURIComponent("Hola, quiero conversar sobre un proyecto")}` : undefined;
---
