---
interface Props { name: string }
const { name } = Astro.props;
const logos: Record<string, string> = {
  "Next.js": "nextdotjs", React: "react", AngularJS: "angular", TypeScript: "typescript", "Tailwind CSS": "tailwind-css",
  "Node.js": "nodejs", Express: "express", NestJS: "nestjs", Prisma: "prisma", PostgreSQL: "postgresql", Supabase: "supabase", "Odoo 15": "odoo",
  Expo: "expo", Flutter: "flutter", Cordova: "cordova", Android: "android", WordPress: "wordpress", WooCommerce: "woocommerce",
  Shopify: "shopify", "Google Apps Script": "google-apps-script", "Google Sheets": "google-sheets", "Google Calendar": "google-calendar", Keycloak: "keycloak",
};
const monochrome = new Set(["Next.js", "Express", "Prisma", "Expo", "Keycloak"]);
const initials: Record<string, string> = {
  "Next.js": "N", React: "⚛", AngularJS: "A", TypeScript: "TS", "Tailwind CSS": "≋",
  "Node.js": "JS", Express: "EX", NestJS: "N", Prisma: "P", WebSockets: "↔",
  PostgreSQL: "PG", DynamoDB: "DB", Supabase: "S", "React Native": "⚛", Expo: "E",
  Flutter: "F", FlutterFlow: "FF", Cordova: "C", Android: "A", WordPress: "W",
  WooCommerce: "W", Shopify: "S", "Inteligencia artificial": "AI", "APIs REST": "API",
  "Google Apps Script": "G", "Google Sheets": "▦", "Google Calendar": "31", Keycloak: "K",
  AWS: "aws", "AWS Cognito": "C",
};
const label = initials[name] ?? name.slice(0, 2).toUpperCase();
const brandClass: Record<string, string> = {
  "Next.js": "text-slate-900 dark:fill-white", React: "text-cyan-500", AngularJS: "text-red-600",
  TypeScript: "text-blue-700", "Tailwind CSS": "text-cyan-500", "Node.js": "text-green-700",
  NestJS: "text-rose-600", PostgreSQL: "text-sky-800", DynamoDB: "text-indigo-600",
  Supabase: "text-emerald-600", "React Native": "text-cyan-500", Expo: "text-slate-900 dark:fill-white",
  Flutter: "text-sky-500", Cordova: "text-blue-700", Android: "text-green-600", WordPress: "text-sky-800",
  WooCommerce: "text-violet-700", Shopify: "text-green-700", "Inteligencia artificial": "text-violet-600",
  "Google Apps Script": "text-amber-600", "Google Sheets": "text-green-700", "Google Calendar": "text-blue-600",
  Keycloak: "text-sky-700", AWS: "text-amber-600", "AWS Cognito": "text-amber-600",
};
const cls = brandClass[name] ?? "text-slate-600 dark:text-slate-300";
---
{logos[name] ? <img src={`/technologies/${logos[name]}.svg`} alt="" aria-hidden="true" width="20" height="20" loading="lazy" decoding="async" class={`size-5 shrink-0 object-contain ${monochrome.has(name) ? "dark:brightness-0 dark:invert" : ""}`} /> : <svg viewBox="0 0 32 32" aria-hidden="true" class={`size-5 shrink-0 ${cls}`}>
  {name === "React" || name === "React Native" ? <g fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="16" cy="16" rx="13" ry="5"/><ellipse cx="16" cy="16" rx="13" ry="5" transform="rotate(60 16 16)"/><ellipse cx="16" cy="16" rx="13" ry="5" transform="rotate(120 16 16)"/><circle cx="16" cy="16" r="2.2" fill="currentColor"/></g>
  : name === "Tailwind CSS" ? <path d="M16 8c-4.3 0-7 2.1-8 6.3 1.6-2.1 3.5-2.9 5.7-2.3 1.2.3 2.1 1.3 3.1 2.3 1.6 1.7 3.4 3.7 7.2 3.7 4.3 0 7-2.1 8-6.3-1.6 2.1-3.5 2.9-5.7 2.3-1.2-.3-2.1-1.3-3.1-2.3C21.6 10 19.8 8 16 8Zm-8 9c-4.3 0-7 2.1-8 6.3 1.6-2.1 3.5-2.9 5.7-2.3 1.2.3 2.1 1.3 3.1 2.3 1.6 1.7 3.4 3.7 7.2 3.7 4.3 0 7-2.1 8-6.3-1.6 2.1-3.5 2.9-5.7 2.3-1.2-.3-2.1-1.3-3.1-2.3C13.6 19 11.8 17 8 17Z" transform="translate(0 -3) scale(.9)"/>
  : name === "AngularJS" ? <path d="m16 2 13 4-2 18-11 6L5 24 3 6l13-4Zm0 5L9 23h4l1.4-4h3.2l1.4 4h4L16 7Zm0 5 1.5 4h-3l1.5-4Z"/>
  : name === "WordPress" || name === "WooCommerce" ? <><circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2"/><text x="16" y="22" text-anchor="middle" font-size="17" font-family="Georgia,serif" font-weight="bold" fill="currentColor">W</text></>
  : name === "Shopify" ? <><path d="m8 10 2-5h12l2 5 2 19H6l2-19Z"/><text x="16" y="24" text-anchor="middle" font-size="13" font-family="Georgia,serif" font-style="italic" fill="white">S</text></>
  : name === "Node.js" ? <><path d="m16 2 13 7v14l-13 7-13-7V9l13-7Z"/><text x="16" y="20" text-anchor="middle" font-size="8" font-weight="bold" fill="white">JS</text></>
  : name === "TypeScript" ? <><rect x="3" y="3" width="26" height="26" rx="3"/><text x="16" y="21" text-anchor="middle" font-size="13" font-weight="bold" fill="white">TS</text></>
  : name === "Next.js" ? <><circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="2"/><path d="M10 23V9l12 15M19 9v8" fill="none" stroke="currentColor" stroke-width="2"/></>
  : name === "WebSockets" ? <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11h17l-4-4m4 4-4 4M27 21H10l4 4m-4-4 4-4"/></g>
  : name === "DynamoDB" ? <g fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="16" cy="7" rx="10" ry="4"/><path d="M6 7v17c0 2 4.5 4 10 4s10-2 10-4V7M6 15c0 2 4.5 4 10 4s10-2 10-4"/></g>
  : name === "AWS" || name === "AWS Cognito" ? <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 24h16a5 5 0 0 0 .5-10 8.5 8.5 0 0 0-16-1A5.5 5.5 0 0 0 8 24Z"/><path d="M11 28c5 2 11 1 15-2"/></g>
  : name === "APIs REST" ? <g fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="16" r="3"/><circle cx="25" cy="7" r="3"/><circle cx="25" cy="25" r="3"/><path d="m10 15 12-7M10 17l12 7"/></g>
  : name === "Inteligencia artificial" ? <path d="M16 2 19 11l9 3-9 3-3 9-3-9-9-3 9-3 3-9Zm10 19 1.5 4.5L32 27l-4.5 1.5L26 33l-1.5-4.5L20 27l4.5-1.5L26 21Z" transform="translate(0 -2)"/>
  : name === "FlutterFlow" ? <path d="M17 3h12L16 16l-6-6L17 3Zm-7 10 6 6-6 6-6-6 6-6Zm7 3 12 12H17l-6-6 6-6Z"/>
  : <><rect x="2" y="2" width="28" height="28" rx="8" opacity=".12"/><text x="16" y="21" text-anchor="middle" font-size={label.length > 2 ? "8" : "12"} font-weight="700" fill="currentColor">{label}</text></>}
</svg>}
