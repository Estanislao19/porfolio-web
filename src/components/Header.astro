---
import ThemeToggle from "./ThemeToggle.astro";
import BrandLogo from "./BrandLogo.astro";
const homePrefix = Astro.url.pathname === "/" ? "" : "/";
const navItems = [
  { title: "Servicios", url: `${homePrefix}#servicios` },
  { title: "Tecnologías", url: `${homePrefix}#tecnologias` },
  { title: "Proyectos", url: `${homePrefix}#proyectos` },
  { title: "Proceso", url: `${homePrefix}#proceso` },
  { title: "Experiencia", url: `${homePrefix}#experiencia` },
  { title: "Nosotros", url: `${homePrefix}#quienes-somos` },
  { title: "Contacto", url: `${homePrefix}#contacto` },
];
---
<header class="fixed inset-x-0 top-3 z-50 px-3 sm:px-5">
  <nav class="mx-auto flex max-w-6xl items-center justify-between rounded-2xl border border-slate-200/80 bg-white/85 px-3 py-2 shadow-lg shadow-slate-900/5 backdrop-blur-xl dark:border-slate-700/80 dark:bg-slate-950/80 sm:px-5" aria-label="Navegación principal">
    <a href="/#inicio" class="flex shrink-0 items-center gap-2 rounded-lg" aria-label="Dev-Tech, inicio"><BrandLogo variant="mark" alt="" width={160} height={71} class="h-8 w-10" /><span class="text-sm font-bold tracking-tight text-slate-900 dark:text-white">Dev-Tech</span></a>
    <div class="hidden items-center gap-0.5 lg:flex xl:gap-1">{navItems.map((item) => <a class="rounded-lg px-2 py-2 text-xs font-medium text-slate-600 transition hover:bg-slate-100 hover:text-cyan-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-600 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-cyan-300" href={item.url}>{item.title}</a>)}</div>
    <div class="flex items-center gap-2"><ThemeToggle /><button id="mobile-nav-toggle" class="grid size-10 place-items-center rounded-xl border border-slate-200 text-slate-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-600 dark:border-slate-700 dark:text-slate-200 lg:hidden" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Abrir menú"><svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button></div>
    <div id="mobile-nav" class="absolute left-0 right-0 top-[calc(100%+8px)] hidden rounded-2xl border border-slate-200 bg-white/95 p-2 shadow-xl backdrop-blur-xl dark:border-slate-700 dark:bg-slate-950/95 lg:hidden"><div class="grid">{navItems.map((item) => <a class="rounded-xl px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800" href={item.url}>{item.title}</a>)}</div></div>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>("#mobile-nav-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-nav");
  const closeMenu = (restoreFocus = false) => { menu?.classList.add("hidden"); toggle?.setAttribute("aria-expanded", "false"); toggle?.setAttribute("aria-label", "Abrir menú"); if (restoreFocus) toggle?.focus(); };
  toggle?.addEventListener("click", () => { const open = toggle.getAttribute("aria-expanded") !== "true"; toggle.setAttribute("aria-expanded", String(open)); toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú"); menu?.classList.toggle("hidden", !open); });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => closeMenu()));
  document.addEventListener("keydown", (event) => { if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") closeMenu(true); });
  document.addEventListener("click", (event) => { const target = event.target; if (target instanceof Node && toggle?.getAttribute("aria-expanded") === "true" && !menu?.contains(target) && !toggle.contains(target)) closeMenu(); });
</script>
