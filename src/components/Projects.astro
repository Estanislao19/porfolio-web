---
import { projects } from "@/data-projects";
import imageSourceManifest from "@/data/project-image-sources.json";
const imageSources: Record<string, { width: number; height: number; srcset: string }> = imageSourceManifest;
const featuredOrder = projects.filter((project) => project.featured).sort((a, b) => (a.featuredOrder ?? 99) - (b.featuredOrder ?? 99)).map((project) => project.title);
const catalogProjects = [...projects.filter((project) => project.featured).sort((a, b) => (a.featuredOrder ?? 99) - (b.featuredOrder ?? 99)), ...projects.filter((project) => !project.featured)];
const categories = ["Todos", ...new Set(projects.map((project) => project.category))];
const summaryLimit = 148;
const summaryFor = (description: string) => { if (description.length <= summaryLimit) return description; const boundary = description.lastIndexOf(" ", summaryLimit); return `${description.slice(0, boundary > 0 ? boundary : summaryLimit)}…`; };
const detailsFor = (description: string) => { const boundary = description.lastIndexOf(" ", summaryLimit); return description.slice(boundary > 0 ? boundary + 1 : summaryLimit).trimStart(); };
---
<div class="mb-8 flex flex-wrap gap-2" aria-label="Filtrar proyectos por categoría">
  {categories.map((category) => <button class="project-filter rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-600 transition hover:border-cyan-500 hover:text-cyan-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 aria-pressed:border-slate-950 aria-pressed:bg-slate-950 aria-pressed:text-white dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:text-cyan-200 dark:aria-pressed:border-cyan-300 dark:aria-pressed:bg-cyan-300 dark:aria-pressed:text-slate-950" data-filter={category} aria-pressed={category === "Todos"}>{category}</button>)}
</div>
<div class="grid auto-rows-fr gap-5 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4" id="projects-grid">
  {catalogProjects.map((project) => <article class="project-card group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/5 dark:border-slate-800 dark:bg-slate-900/60" data-category={project.category} data-featured={project.featured ? "true" : "false"} data-search-title={project.title.toLowerCase()} data-featured-index={featuredOrder.indexOf(project.title)} style={!project.featured ? "display:none" : undefined} data-featured-order={project.featuredOrder ?? 99}>
    <button class="project-image relative flex h-48 w-full shrink-0 cursor-zoom-in items-center justify-center overflow-hidden bg-slate-100 p-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-inset focus-visible:outline-cyan-600 dark:bg-slate-800 sm:h-52" type="button" aria-label={`Ampliar imagen del proyecto ${project.title}`} data-image={project.image ?? ""} data-title={project.title}>
      {project.image ? <img src={project.image} srcset={imageSources[project.image]?.srcset} sizes="(min-width: 1536px) 20vw, (min-width: 1280px) 28vw, (min-width: 640px) 45vw, 100vw" width={imageSources[project.image]?.width} height={imageSources[project.image]?.height} alt={`Captura de ${project.title}`} loading="lazy" decoding="async" class={`h-full w-full transition duration-500 group-hover:scale-[1.025] ${project.category === "Aplicaciones móviles" ? "object-contain" : "object-cover"}`} /> : <span class="text-sm text-slate-500">Imagen no disponible</span>}
      <span class="absolute bottom-3 right-3 rounded-full bg-slate-950/80 px-3 py-2 text-xs font-semibold text-white opacity-100 shadow-md transition sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100">Ampliar imagen ↗</span>
    </button>
    <div class="flex flex-1 flex-col p-5">
      <p class="mb-2 text-[11px] font-semibold uppercase tracking-[.16em] text-cyan-800 dark:text-cyan-300">{project.category}</p>
      <h3 class="text-base font-semibold leading-snug text-slate-950 dark:text-white">{project.title}</h3>
      {project.status && <p class="mt-2 w-fit rounded-full border border-cyan-200 bg-cyan-50 px-2.5 py-1 text-[11px] font-semibold text-cyan-900 dark:border-cyan-900 dark:bg-cyan-950/60 dark:text-cyan-200">{project.status}</p>}
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{summaryFor(project.description)}</p>
      {project.technologies.length > 0 && <ul class="mt-4 flex flex-wrap gap-1.5">{project.technologies.slice(0, 5).map((technology) => <li class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-medium text-slate-700 dark:bg-slate-800 dark:text-slate-200">{technology}</li>)}</ul>}
      {project.description.length > summaryLimit && <details class="project-details mt-auto pt-4 text-sm text-cyan-800 dark:text-cyan-300"><summary class="cursor-pointer font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-600">Ver más detalles</summary><p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{detailsFor(project.description)}</p></details>}
      {project.link && <a href={project.link} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex min-h-10 w-fit items-center rounded-full border border-slate-300 px-4 text-xs font-semibold text-slate-800 transition hover:border-cyan-600 hover:text-cyan-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-600 dark:border-slate-700 dark:text-white dark:hover:text-cyan-200" aria-label={`Visitar enlace del proyecto ${project.title}`}>Visitar proyecto <span aria-hidden="true" class="ml-2">↗</span></a>}
    </div>
  </article>)}
</div>
<div class="mt-9 text-center"><button id="show-all-projects" class="rounded-full bg-slate-950 px-6 py-3 text-sm font-semibold text-white transition hover:bg-cyan-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-600 dark:bg-white dark:text-slate-950 dark:hover:bg-cyan-200">Ver catálogo completo ({projects.length})</button></div>
<dialog id="project-image-dialog" class="m-auto max-h-[92dvh] max-w-[94vw] overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/85 dark:border-slate-700 dark:bg-slate-900 dark:text-white" aria-labelledby="project-dialog-title"><div class="flex items-center justify-between gap-4 p-3 sm:p-4"><h3 id="project-dialog-title" class="text-sm font-semibold"></h3><button id="close-project-dialog" type="button" class="grid size-10 shrink-0 place-items-center rounded-full border border-slate-300 text-lg hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-600 dark:border-slate-700 dark:hover:bg-slate-800" aria-label="Cerrar imagen">×</button></div><img id="project-dialog-image" alt="" class="max-h-[calc(92dvh-4rem)] max-w-[94vw] object-contain" /></dialog>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>(".project-card")];
  const filters = [...document.querySelectorAll<HTMLButtonElement>(".project-filter")];
  const showAll = document.querySelector<HTMLButtonElement>("#show-all-projects");
  const dialog = document.querySelector<HTMLDialogElement>("#project-image-dialog");
  const dialogImage = document.querySelector<HTMLImageElement>("#project-dialog-image");
  const dialogTitle = document.querySelector<HTMLElement>("#project-dialog-title");
  let expanded = false;
  let active = "Todos";
  const render = () => {
    cards.forEach((card) => { card.style.display = active === "Todos" && (expanded || card.dataset.featured === "true") || active !== "Todos" && card.dataset.category === active ? "" : "none"; });
    filters.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.filter === active)));
    if (showAll) showAll.textContent = active !== "Todos" ? "Ver todos los proyectos" : expanded ? "Mostrar proyectos destacados" : `Ver catálogo completo (${cards.length})`;
  };
  filters.forEach((button) => button.addEventListener("click", () => { active = button.dataset.filter ?? "Todos"; render(); }));
  showAll?.addEventListener("click", () => { if (active !== "Todos") expanded = true; else expanded = !expanded; active = "Todos"; render(); });
  document.querySelectorAll<HTMLButtonElement>(".project-image").forEach((button) => button.addEventListener("click", () => { const src = button.dataset.image; if (!src || !dialog || !dialogImage) return; dialogImage.src = src; dialogImage.alt = `Imagen ampliada: ${button.dataset.title ?? "proyecto"}`; if (dialogTitle) dialogTitle.textContent = button.dataset.title ?? "Proyecto"; dialog.showModal(); }));
  const closeDialog = () => dialog?.close();
  document.querySelector<HTMLButtonElement>("#close-project-dialog")?.addEventListener("click", closeDialog);
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) closeDialog(); });
</script>
