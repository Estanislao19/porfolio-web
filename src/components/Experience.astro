---
const experience = [
  { role: "Fundador y desarrollador Full Stack", company: "LazaroCode", description: "Creación de productos digitales para empresas y profesionales, desde la definición técnica y el desarrollo hasta QA, despliegue y evolución. LazaroCode es una iniciativa independiente de Dev-Tech.", link: "https://lazarocode.com/" },
  { role: "Desarrollo y optimización de aplicaciones móviles", company: "Dev-Tech", description: "Trabajo en aplicaciones Android e iOS: análisis técnico, optimización, resolución de errores, QA, preparación de builds y publicación de versiones." },
  { role: "Desarrollo de plataformas de análisis", company: "Laikad", description: "Desarrollo de dos versiones de una plataforma para análisis y seguimiento de campañas, junto con el sitio institucional de la empresa." },
  { role: "Desarrollo de plataformas para eventos", company: "Groove / Fest-Go", description: "Desarrollo de productos para gestión de eventos, venta de tickets, operación de barras y servicios backend para restaurantes y barras." },
];
---
<div class="grid gap-4 xl:grid-cols-4">{experience.map((item, index) => <article class="relative flex flex-col rounded-2xl border border-slate-200 bg-white/75 p-6 dark:border-slate-800 dark:bg-slate-900/60"><span class="mb-6 grid size-10 place-items-center rounded-xl bg-cyan-50 text-xs font-bold tracking-wide text-cyan-800 dark:bg-cyan-950 dark:text-cyan-200">0{index + 1}</span><p class="text-xs font-semibold uppercase tracking-[.15em] text-slate-500 dark:text-slate-400">{item.company}</p><h3 class="mt-2 text-lg font-semibold leading-snug text-slate-950 dark:text-white">{item.role}</h3><p class="mt-3 flex-1 text-sm leading-6 text-slate-600 dark:text-slate-300">{item.description}</p>{item.link && <a class="mt-5 inline-flex min-h-9 w-fit items-center text-sm font-medium text-cyan-800 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-cyan-600 dark:text-cyan-300" href={item.link} target="_blank" rel="noopener noreferrer">Conocer LazaroCode <span aria-hidden="true" class="ml-2">↗</span></a>}</article>)}</div>
