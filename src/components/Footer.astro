---
const currentYear = new Date().getFullYear();
import { siteConfig } from "@/config/site.mjs";
import BrandLogo from "@/components/BrandLogo.astro";
const email = siteConfig.email;
const whatsappNumber = siteConfig.whatsappNumber;
const whatsappHref = whatsappNumber ? `https://wa.me/${whatsappNumber.replace(/\D/g, "")}` : undefined;
---
<footer class="mt-20 border-t border-slate-200/80 dark:border-slate-800"><div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 sm:grid-cols-2 sm:items-center lg:px-8"><div><a href="/#inicio" class="inline-flex items-center gap-2"><BrandLogo variant="mark" alt="" width={160} height={71} class="h-8 w-10" /><span class="font-semibold text-slate-900 dark:text-white">Dev-Tech</span></a><p class="mt-3 max-w-sm text-sm leading-6 text-slate-600 dark:text-slate-400">Desarrollo de software y soluciones digitales para empresas.</p></div><div class="flex flex-wrap gap-x-5 gap-y-3 text-sm sm:justify-end"><a class="text-slate-600 hover:text-cyan-700 dark:text-slate-300 dark:hover:text-cyan-300" href="/#servicios">Servicios</a><a class="text-slate-600 hover:text-cyan-700 dark:text-slate-300 dark:hover:text-cyan-300" href="/#proyectos">Proyectos</a><a class="text-slate-600 hover:text-cyan-700 dark:text-slate-300 dark:hover:text-cyan-300" href="/#quienes-somos">Nosotros</a><a class="text-slate-600 hover:text-cyan-700 dark:text-slate-300 dark:hover:text-cyan-300" href={`mailto:${email}`}>Email</a>{whatsappHref && <a class="text-slate-600 hover:text-cyan-700 dark:text-slate-300 dark:hover:text-cyan-300" href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a>}</div><p class="text-xs text-slate-500 dark:text-slate-500 sm:col-span-2">© {currentYear} Dev-Tech. Todos los derechos reservados.</p></div></footer>
